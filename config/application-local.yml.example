# 本地开发配置示例。复制为 config/application-local.yml（已被 .gitignore 忽略）后修改。
# 该文件在 application.yml 中通过 spring.config.import 可选导入，优先级高于 application.yml。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/campus_ai?characterEncoding=UTF-8
    username: campus
    password: change-me

app:
  security:
    jwt:
      # 本地开发也请使用随机生成的值：openssl rand -base64 48
      secret: replace-with-a-random-string-of-at-least-32-bytes
    cors:
      allowed-origins: http://localhost:5173
