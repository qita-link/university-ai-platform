# =====================================================================
# 环境变量模板。复制为 .env（已被 .gitignore 忽略）或在部署平台中配置。
# 带 [必填] 的变量没有安全默认值，未配置时应用将拒绝启动或相关功能不可用。
# =====================================================================

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/campus_ai?characterEncoding=UTF-8
DB_USERNAME=campus
# [必填]
DB_PASSWORD=
# 会话时区，应与 APP_TIME_ZONE 相同（使用偏移量形式）
DB_SESSION_TIME_ZONE=+08:00
DB_POOL_MAX=20

# ---- 安全 ----
# [必填] JWT 签名密钥，至少 32 字节：openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_ISSUER=campus-ai-platform
APP_JWT_ACCESS_TTL=2h
# 允许跨域的前端来源，逗号分隔；留空表示不开放跨域
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 登录安全 ----
# 连续失败多少次后临时锁定，以及锁定时长
APP_LOGIN_MAX_FAILED_ATTEMPTS=5
APP_LOGIN_LOCK_DURATION=15m
# 进程内令牌桶限流（单实例有效；多实例部署时每个实例单独计数）
APP_LOGIN_RATE_LIMIT_ENABLED=true
APP_LOGIN_RATE_PER_IP_USER=10
APP_LOGIN_RATE_PER_IP=60
# 密码至少 8 位，至少包含小写/大写/数字/符号中的 3 类
APP_PASSWORD_MIN_LENGTH=8

# ---- 知识库 ----
APP_KB_MAX_CHUNK_CHARS=800
APP_KB_CHUNK_OVERLAP_CHARS=120
APP_KB_MAX_FILE_BYTES=2097152
APP_KB_MAX_FILES_PER_BATCH=20
# 仅开发/演示：把本地 Markdown 目录导入知识库。生产保持 false。
APP_KB_IMPORT_ENABLED=false
APP_KB_IMPORT_DIR=
APP_KB_IMPORT_CATEGORY=SJTU Wiki
APP_KB_IMPORT_SPACE=SJTU Wiki
APP_KB_IMPORT_OWNER=admin

# ---- 知识库检索 / AI 问答 ----
APP_SEARCH_TOP_K=5
APP_SEARCH_MAX_TOP_K=20
APP_SEARCH_MIN_SCORE=0.0
APP_SEARCH_CANDIDATE_FACTOR=4
APP_SEARCH_SNIPPET_CHARS=300
APP_AI_TOP_K=5
APP_AI_MAX_CONTEXT_TOKENS=3000
APP_AI_MAX_ANSWER_TOKENS=800
APP_AI_TEMPERATURE=0.2
APP_AI_HISTORY_MESSAGES=6
# AI 工具调用：写操作工具生成的待确认记录有效期（超时确认返回 409）
APP_AI_TOOL_CONFIRM_TTL=10m

# ---- 初始管理员（仅在系统中没有可用管理员时创建；创建成功后请移除密码变量）----
APP_BOOTSTRAP_ADMIN_USERNAME=admin
# 至少 12 位
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# ---- 通用 ----
SERVER_PORT=8080
APP_TIME_ZONE=Asia/Shanghai
APP_LOG_PATH=./logs
# 生产环境建议 false
APP_SWAGGER_ENABLED=true
# 部署在 Nginx 等反向代理之后时设为 native
SERVER_FORWARD_HEADERS_STRATEGY=none

# ---- 上传 ----
UPLOAD_MAX_FILE_SIZE=2MB
UPLOAD_MAX_REQUEST_SIZE=20MB

# ---- 大模型（OpenAI 兼容协议）----
# none = 不启用聊天模型；openai = 启用（可对接 OpenAI / DeepSeek / 通义千问兼容模式 / Ollama 等）
AI_CHAT_PROVIDER=none
AI_BASE_URL=https://api.openai.com
# [启用 AI 时必填]
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024
AI_CONNECT_TIMEOUT=10s
AI_READ_TIMEOUT=60s
AI_RETRY_MAX_ATTEMPTS=2
# 阶段四接入 Qdrant 时启用
AI_EMBEDDING_PROVIDER=none
