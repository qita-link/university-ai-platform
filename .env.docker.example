# =====================================================================
# Docker 部署变量模板：复制为 .env.docker 后填入自己的值
#   cp .env.docker.example .env.docker
#   openssl rand -base64 32   # 生成密码
#   openssl rand -base64 48   # 生成 APP_JWT_SECRET
# =====================================================================

# ---- 数据库 ----
DB_NAME=campus_ai
DB_USERNAME=campus
# [必填]
DB_PASSWORD=
# [必填] root 密码只在容器内部用，不会暴露到应用
DB_ROOT_PASSWORD=
DB_HOST_PORT=3307
DB_POOL_MAX=20

# ---- 安全 ----
# [必填] 至少 32 字节；更换后所有人需要重新登录
APP_JWT_SECRET=
# 留空表示不开放跨域（前端由 Nginx 同源反代，通常不需要）
APP_CORS_ALLOWED_ORIGINS=

# ---- 对外端口 ----
WEB_HOST_PORT=8088

# ---- 管理员（仅空库首次启动生效）----
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# ---- AI ----
AI_CHAT_PROVIDER=none
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
